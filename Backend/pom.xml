<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================== -->
    <!-- CẤU HÌNH SPRING BOOT -->
    <!-- ==========================================-->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <!-- ========================================== -->
    <!-- THÔNG TIN DỰ ÁN BLOCKCHAINCB -->
    <!-- ========================================== -->
    <groupId>com</groupId>
    <artifactId>blockchaincb</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>BlockchainCB</name>
    <description>Hệ thống quản lý hồ sơ bệnh án sử dụng Blockchain</description>

    <!-- Phiên bản Java -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- ========================================== -->
    <!-- CÁC THƯ VIỆN CHÍNH -->
    <!-- ========================================== -->
    <dependencyManagement>
        <dependencies><dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-bom</artifactId>
            <version>18.3.0</version>
            <type>pom</type>
            <scope>import</scope>
        </dependency></dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Database kiểm thử riêng, không dùng cấu hình Supabase. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Xây dựng REST API bằng Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Xác thực đăng nhập và phân quyền người dùng -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Tương tác cơ sở dữ liệu bằng Spring Data JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Kết nối PostgreSQL của Supabase -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Kiểm tra dữ liệu đầu vào -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================================== -->
        <!-- THƯ VIỆN KIỂM THỬ -->
        <!-- ========================================== -->

        <!-- Kiểm thử Controller và REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kiểm thử Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kiểm thử Repository và JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Kiểm thử Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================================== -->
    <!-- CẤU HÌNH BUILD SPRING BOOT -->
    <!-- ========================================== -->
    <build>
        <plugins>

            <!-- Plugin đóng gói và chạy Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>postgres-it</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions><execution><goals>
                    <goal>integration-test</goal><goal>verify</goal>
                </goals></execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
